# Rendered to /etc/nginx/conf.d/default.conf at container start; ${API_GATEWAY_URL} is the only
# substituted value (see the Dockerfile).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # The gateway's actuator (health, Prometheus metrics) is for the cluster only: probes and
    # scrapers reach the pods directly, never through this proxy (ADR-021). ^~ also stops the
    # regex location below from matching here.
    location ^~ /api/actuator {
        return 404;
    }

    # API and WebSocket traffic, same-origin. The trailing slash on proxy_pass strips the /api
    # prefix, so /api/events/1 reaches api-gateway as /events/1 — no gateway change needed, and
    # the SPA keeps /events/:id and /bookings/:id for itself (ADR-019).
    location /api/ {
        proxy_pass ${API_GATEWAY_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Seat-status WebSockets stay open while a seat map is on screen.
        proxy_read_timeout 1h;
    }

    # Liveness/readiness for Kubernetes; doesn't depend on api-gateway.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build output never changes under the same name.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/events/:id, /bookings/:id, ...) fall back to the app shell, which
    # must not be cached so a new deploy is picked up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
